// YARKAITA PLATFORM - Prisma Schema
// Full Schema: Foundation + Catalog + Inventory + Commerce + Production + Bespoke/Bridal + System
// Compatible with PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerAcquisitionSource {
  INSTAGRAM
  WHATSAPP
  TIKTOK
  WALK_IN
  REFERRAL
  WEBSITE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ========== USER & AUTH ==========

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  staffProfile StaffProfile?
  roles        UserRole[]
  locations    UserLocation[]
  requestedTransfers StockTransfer[] @relation("RequestedBy")
  approvedTransfers  StockTransfer[] @relation("ApprovedBy")
  assignedProductionTasks ProductionTask[] @relation("AssignedUser")
  qualityChecks         QualityCheck[]   @relation("CheckedBy")
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([name])
}

model StaffProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  employeeCode String   @unique
  department   String
  position     String
  hireDate     DateTime?
  notes        String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles       RolePermission[]
}

// Join tables

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ========== LOCATIONS ==========

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String   @unique
  address   String?
  city      String?
  state     String?
  country   String   @default("Nigeria")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     UserLocation[]
  inventoryBalances InventoryBalance[]
  stockTransfersFrom StockTransfer[] @relation("FromLocation")
  stockTransfersTo   StockTransfer[] @relation("ToLocation")
  inventoryMovements InventoryMovement[]
}

model UserLocation {
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
}

// ========== CUSTOMERS ==========

model Customer {
  id                String                    @id @default(uuid()) @db.Uuid
  customerCode      String                    @unique
  firstName         String
  lastName          String
  email             String?
  phone             String?
  gender            Gender?
  acquisitionSource CustomerAcquisitionSource
  notes             String?
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  addresses            CustomerAddress[]
  measurementProfiles  MeasurementProfile[]
  orders               Order[]
  bespokeRequests      BespokeRequest[]
  bridalRequests       BridalRequest[]

  @@index([lastName, firstName])
  @@index([phone])
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  label      String?
  address    String
  city       String?
  state      String?
  country    String   @default("Nigeria")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model MeasurementProfile {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  name        String   @default("Default")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  versions    MeasurementVersion[]

  @@index([customerId])
}

model MeasurementVersion {
  id                    String   @id @default(uuid()) @db.Uuid
  measurementProfileId  String   @db.Uuid
  version               Int
  notes                 String?
  createdAt             DateTime @default(now())

  measurementProfile    MeasurementProfile @relation(fields: [measurementProfileId], references: [id], onDelete: Cascade)
  measurements          Measurement[]

  @@unique([measurementProfileId, version])
  @@index([measurementProfileId])
}

model Measurement {
  id                    String   @id @default(uuid()) @db.Uuid
  measurementVersionId  String   @db.Uuid
  name                  String
  value                 Decimal  @db.Decimal(10, 2)
  unit                  String   @default("cm")

  measurementVersion    MeasurementVersion @relation(fields: [measurementVersionId], references: [id], onDelete: Cascade)

  @@index([measurementVersionId])
}

// ========== CATALOG ==========

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductCollection[]
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  categoryId  String   @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants      ProductVariant[]
  media         ProductMedia[]
  collections   ProductCollection[]
  productionJobs ProductionJob[]

  @@index([categoryId])
  @@index([name])
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  color     String?
  size      String?
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  transferItems      StockTransferItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductMedia {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      String   @default("image")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductCollection {
  productId    String     @db.Uuid
  collectionId String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

// ========== INVENTORY ==========

model InventoryBalance {
  id         String   @id @default(uuid()) @db.Uuid
  variantId  String   @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([variantId, locationId])
  @@index([locationId])
}

model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  variantId   String   @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  locationId  String   @db.Uuid
  location    Location @relation(fields: [locationId], references: [id])
  type        String
  quantity    Int
  referenceId String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([variantId])
  @@index([locationId])
  @@index([type])
}

model StockTransfer {
  id            String   @id @default(uuid()) @db.Uuid
  transferNumber String  @unique
  fromLocationId String   @db.Uuid
  fromLocation  Location @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId  String   @db.Uuid
  toLocation    Location @relation("ToLocation", fields: [toLocationId], references: [id])
  status        String   @default("REQUESTED")
  requestedById String?  @db.Uuid
  requestedBy   User?    @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById  String?  @db.Uuid
  approvedBy    User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  shippedAt     DateTime?
  receivedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
}

model StockTransferItem {
  id              String   @id @default(uuid()) @db.Uuid
  transferId      String   @db.Uuid
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId       String   @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  receivedQuantity Int     @default(0)

  @@index([transferId])
  @@index([variantId])
}

// ========== COMMERCE ==========

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  customerId String?    @db.Uuid
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items      CartItem[]
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  productId String @db.Uuid
  variantId String @db.Uuid
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model Order {
  id           String   @id @default(uuid()) @db.Uuid
  orderNumber  String   @unique
  customerId   String   @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  status       String   @default("PENDING")
  salesChannel String
  totalAmount  Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items       OrderItem[]
  address     OrderAddress?
  payments    Payment[]
  productionJobs ProductionJob[]
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  sku         String
  size        String?
  color       String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(10, 2)
}

model OrderAddress {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  address String
  city    String?
  state   String?
  country String @default("Nigeria")
}

model Payment {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id])
  reference  String   @unique
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("SUCCESSFUL")
  receiptUrl String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ========== PRODUCTION ==========

model ProductionJob {
  id        String   @id @default(uuid()) @db.Uuid
  jobNumber String   @unique
  orderId   String?  @db.Uuid
  order     Order?   @relation(fields: [orderId], references: [id])
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
  status    String   @default("IN_PROGRESS")
  priority  String   @default("NORMAL")
  dueDate   DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     ProductionTask[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
}

model ProductionTask {
  id              String   @id @default(uuid()) @db.Uuid
  productionJobId String   @db.Uuid
  productionJob   ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  assignedUserId  String?  @db.Uuid
  assignedUser    User?    @relation("AssignedUser", fields: [assignedUserId], references: [id])
  department      String
  taskType        String
  status          String   @default("PENDING")
  priority        String   @default("NORMAL")
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  qualityChecks   QualityCheck[]

  @@index([productionJobId])
  @@index([assignedUserId])
  @@index([status])
}

model QualityCheck {
  id               String   @id @default(uuid()) @db.Uuid
  productionTaskId String   @db.Uuid
  productionTask   ProductionTask @relation(fields: [productionTaskId], references: [id], onDelete: Cascade)
  checkedById      String?  @db.Uuid
  checkedBy        User?    @relation("CheckedBy", fields: [checkedById], references: [id])
  status           String   @default("PENDING")
  notes            String?
  createdAt        DateTime @default(now())

  @@index([productionTaskId])
  @@index([checkedById])
}

// ========== BESPOKE / BRIDAL ==========

model BespokeRequest {
  id            String   @id @default(uuid()) @db.Uuid
  requestNumber String   @unique
  customerId    String   @db.Uuid
  customer      Customer @relation(fields: [customerId], references: [id])
  description   String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  media         BespokeMedia[]
  quotes        Quote[]
}

model BespokeMedia {
  id               String @id @default(uuid()) @db.Uuid
  bespokeRequestId String @db.Uuid
  bespokeRequest   BespokeRequest @relation(fields: [bespokeRequestId], references: [id], onDelete: Cascade)
  url              String
  type             String @default("image")
  createdAt        DateTime @default(now())

  @@index([bespokeRequestId])
}

model BridalRequest {
  id            String   @id @default(uuid()) @db.Uuid
  requestNumber String   @unique
  customerId    String   @db.Uuid
  customer      Customer @relation(fields: [customerId], references: [id])
  description   String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  media         BridalMedia[]
  quotes        Quote[]
}

model BridalMedia {
  id              String @id @default(uuid()) @db.Uuid
  bridalRequestId String @db.Uuid
  bridalRequest   BridalRequest @relation(fields: [bridalRequestId], references: [id], onDelete: Cascade)
  url             String
  type            String @default("image")
  createdAt       DateTime @default(now())

  @@index([bridalRequestId])
}

model Quote {
  id               String   @id @default(uuid()) @db.Uuid
  quoteNumber      String   @unique
  bespokeRequestId String?  @db.Uuid
  bespokeRequest   BespokeRequest? @relation(fields: [bespokeRequestId], references: [id])
  bridalRequestId  String?  @db.Uuid
  bridalRequest    BridalRequest?  @relation(fields: [bridalRequestId], references: [id])
  status           String   @default("DRAFT")
  totalAmount      Decimal  @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            QuoteItem[]
}

model QuoteItem {
  id         String  @id @default(uuid()) @db.Uuid
  quoteId    String  @db.Uuid
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
}

// ========== SYSTEM ==========

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
}